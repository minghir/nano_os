section .multiboot
align 8
multiboot_header:
    dd 0x1BADB002          ; magic
    dd 0                   ; flags
    dd -(0x1BADB002)       ; checksum

section .text
global _start

BITS 32

_start:
    mov esp, stack_top
    and esp, 0xFFFFFFF0
    cld
    call enable_long_mode
    jmp 0x08:long_mode_start

enable_long_mode:
    call gdt_load

    mov eax, page_table_l3
    mov cr3, eax

    mov eax, cr4
    or eax, (1 << 10) | (1 << 9) | (1 << 5)
    mov cr4, eax

    mov ecx, 0xC0000080
    rdmsr
    or eax, 1 << 8
    wrmsr

    mov eax, cr0
    or eax, 1 << 31
    mov cr0, eax
    extern kernel_main
    ret

BITS 64
long_mode_start:
    mov ax, 0x10
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov rsp, stack_top
    and rsp, 0xFFFFFFFFFFFFFFF0
    call kernel_main

.hang:
    jmp .hang

section .bss
align 16
stack_bottom:
    resb 16384
stack_top:

align 4096
page_table_l4:
    resq 512
page_table_l3:
    resq 512
page_table_l2:
    resq 512

section .data
align 8
gdt_start:
    dq 0
    dq 0x00AF9A000000FFFF
    dq 0x00CF92000000FFFF
gdt_end:

gdt_descriptor:
    dw gdt_end - gdt_start - 1
    dd gdt_start

section .text
BITS 32
gdt_load:
    lgdt [gdt_descriptor]
    mov eax, page_table_l2
    mov dword [page_table_l3], eax
    or dword [page_table_l3], 0x03
    mov eax, page_table_l3
    mov dword [page_table_l4], eax
    or dword [page_table_l4], 0x03
    mov dword [page_table_l2], 0x00000083
    ret

