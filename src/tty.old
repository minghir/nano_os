#include "tty.h"
#include "io.h"

// Alocarea memoriei pentru variabilele globale
TTY ttys[MAX_TTYS];
int active_tty = 1;

extern void cursor_update();


void tty_refresh_active_screen(void) {
    uint16_t* physical_vga = (uint16_t*)0xB8000;
    int active_cursor = ttys[active_tty].cursor;
    
    // Copiem întreg bufferul TTY-ului activ direct pe ecranul fizic
    for (int i = 0; i < 80 * 25; i++) {
        if (i == active_cursor) {
            // Desenăm cursorul inversând culorile (ex: text negru pe fundal alb - 0x7000)
            // Luăm caracterul existent din buffer, dar îi punem atribut de cursor
            uint16_t ch = ttys[active_tty].screen_buffer[i] & 0xFF;
            physical_vga[i] = 0x7000 | ch; 
        } else {
            physical_vga[i] = ttys[active_tty].screen_buffer[i];
        }
    }

    // Actualizăm și poziția hardware a cursorului VGA (dacă folosești porturile VGA CRTC 14/15)
    cursor_update();
}

